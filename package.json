{
  "name": "pokeverse-arena",
  "version": "3.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "shots": "node tools/ui-shots.mjs",
    "e2e": "node tools/e2e-adventure.mjs",
    "lint": "eslint \"src/**/*.{ts,html}\"",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "test:ci": "ng test --no-watch --coverage",
    "verify": "npm run typecheck && npm run lint && npm run i18n:check && npm run test:ci && npm run build",
    "postbuild": "node tools/postbuild.mjs",
    "i18n:check": "node tools/i18n-check.mjs",
    "i18n:scan": "node tools/i18n-scan.mjs",
    "serve:dist": "node tools/serve-dist.mjs",
    "e2e:offline": "node tools/e2e-offline.mjs",
    "perf:overworld": "node tools/perf-overworld.mjs",
    "accept": "node tools/accept.mjs"
  },
  "private": true,
  "packageManager": "npm@11.4.2",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "gsap": "^3.15.0",
    "idb": "^8.0.3",
    "pixi.js": "^8.19.0",
    "rxjs": "~7.8.0",
    "three": "^0.184.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.3",
    "@angular/cli": "^22.0.3",
    "@angular/compiler-cli": "^22.0.0",
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.184.1",
    "@vitest/coverage-v8": "^4.1.9",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.11.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^28.0.0",
    "playwright": "^1.61.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.0.8"
  }
}
